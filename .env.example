# Copy to .env on the server and fill in. Never commit the real .env.

# public address of the site (used in emails and CORS)
FRONTEND_URL=https://bodywise.example.com
# random 32+ characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
APP_TIMEZONE=Asia/Kolkata
# port on 127.0.0.1 that nginx forwards to
FRONTEND_PORT=3010

# 7 pm checklist email (Gmail: create an app password at https://myaccount.google.com/apppasswords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_FROM=you@gmail.com
MAIL_PASSWORD=
